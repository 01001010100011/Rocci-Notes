rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAdminEmail() {
      return request.auth != null
        && request.auth.token.email in [
          'leoriellooo@gmail.com',
          'federicafan09@gmail.com',
          'fmillesimi@gmail.com'
        ];
    }

    // Solo il super-admin gestisce i voucher (creazione/modifica/eliminazione).
    function isSuperAdminEmail() {
      return request.auth != null
        && request.auth.token.email == 'leoriellooo@gmail.com';
    }

    // Codici già riscattati dall'utente: default [] per i documenti precedenti.
    function beforeRedeemed() {
      return 'redeemedCodes' in resource.data ? resource.data.redeemedCodes : [];
    }

    // Contatori classifica: letti con default 0 così funzionano anche sui
    // documenti creati prima dell'introduzione di uploadsCount/downloadsCount.
    function beforeUploads() {
      return 'uploadsCount' in resource.data ? resource.data.uploadsCount : 0;
    }

    function beforeDownloads() {
      return 'downloadsCount' in resource.data ? resource.data.downloadsCount : 0;
    }

    function afterUploads() {
      return 'uploadsCount' in request.resource.data ? request.resource.data.uploadsCount : 0;
    }

    function afterDownloads() {
      return 'downloadsCount' in request.resource.data ? request.resource.data.downloadsCount : 0;
    }

    // Profili utente: leggibili da tutti gli utenti autenticati (serve alla
    // classifica /stats); in scrittura ognuno tocca solo il proprio documento.
    match /users/{userId} {
      allow read: if request.auth != null;

      // Primo accesso: 3 crediti iniziali e contatori classifica a zero; il ruolo
      // 'admin' spetta solo alle email amministratore, così nessuno può auto-assegnarselo.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.credits == 3
        && request.resource.data.uploadsCount == 0
        && request.resource.data.downloadsCount == 0
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == (isAdminEmail() ? 'admin' : 'student')
        && request.resource.data.keys().hasAll([
          'uid', 'email', 'username', 'credits', 'role',
          'uploadsCount', 'downloadsCount', 'createdAt'
        ]);

      allow update: if request.auth != null
        && (
          // Proprietario: crediti ±1, username, email, downloadsCount +1 quando
          // scarica; uploadsCount può solo essere inizializzato a 0 (backfill),
          // mai incrementato da sé.
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'credits', 'username', 'email', 'downloadsCount', 'uploadsCount'
            ])
            && (
              request.resource.data.credits == resource.data.credits
              || request.resource.data.credits == resource.data.credits + 1
              || request.resource.data.credits == resource.data.credits - 1
            )
            && (
              afterDownloads() == beforeDownloads()
              || afterDownloads() == beforeDownloads() + 1
            )
            && afterUploads() == beforeUploads()
          )
          // Upgrade del ruolo al login per le email amministratore.
          || (
            request.auth.uid == userId
            && isAdminEmail()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
            && request.resource.data.role == 'admin'
          )
          // Admin che accredita +1 credito e +1 uploadsCount all'autore approvato.
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'uploadsCount'])
            && request.resource.data.credits == resource.data.credits + 1
            && afterUploads() == beforeUploads() + 1
          )
          // Riscatto voucher: l'utente accredita a sé stesso esattamente i crediti
          // del voucher indicato, una sola volta per codice. Il codice deve esistere
          // in /vouchers e non essere già presente in redeemedCodes dell'utente.
          || (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'credits', 'redeemedCodes', 'lastRedeemedCode'
            ])
            && 'lastRedeemedCode' in request.resource.data
            && request.resource.data.lastRedeemedCode is string
            && request.resource.data.lastRedeemedCode.size() > 0
            && !(request.resource.data.lastRedeemedCode in beforeRedeemed())
            && request.resource.data.lastRedeemedCode in request.resource.data.redeemedCodes
            && request.resource.data.credits == resource.data.credits
              + get(/databases/$(database)/documents/vouchers/$(request.resource.data.lastRedeemedCode)).data.credits
          )
        );

      allow delete: if false;

      // Storico acquisti: l'utente legge e crea solo i propri record di download.
      match /downloads/{downloadId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.noteId == downloadId
          && request.resource.data.keys().hasAll(['noteId', 'title', 'subject', 'fileUrl', 'downloadedAt']);

        allow update, delete: if false;
      }
    }

    // Catalogo appunti: leggibile da tutti gli utenti autenticati.
    match /notes/{noteId} {
      allow read: if request.auth != null;

      // Le note nascono sempre in stato 'pending'.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.downloadsCount == 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 140
        && request.resource.data.subject is string
        && request.resource.data.professor is string
        && request.resource.data.professor.size() > 0
        && request.resource.data.fileUrl is string
        && request.resource.data.fileUrl.matches('https://res\\.cloudinary\\.com/.*')
        && request.resource.data.keys().hasAll([
          'title', 'subject', 'professor', 'description', 'fileUrl',
          'authorId', 'authorName', 'createdAt', 'downloadsCount', 'status'
        ]);

      allow update: if request.auth != null
        && (
          // +1 al contatore download di chi scarica.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['downloadsCount'])
            && request.resource.data.downloadsCount == resource.data.downloadsCount + 1
          )
          // Rinomina dell'authorName da parte dell'autore.
          || (
            resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName'])
          )
          // Approvazione/rifiuto riservati all'admin (il rifiuto porta con sé
          // la motivazione obbligatoria e la scadenza a 7 giorni).
          || (
            isAdmin()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectionReason', 'rejectedAt', 'expireAt'])
            && (
              request.resource.data.status == 'approved'
              || request.resource.data.status == 'rejected'
            )
          )
        );

      allow delete: if request.auth != null
        && (
          resource.data.authorId == request.auth.uid
          // Pulizia dei rifiutati scaduti: solo admin, solo dopo la scadenza.
          || (
            isAdmin()
            && resource.data.status == 'rejected'
            && resource.data.expireAt != null
            && resource.data.expireAt < request.time
          )
        );
    }

    // Voucher / codici promo: leggibili da ogni utente autenticato (serve al
    // riscatto); creati/modificati/eliminati solo dal super-admin. L'aggiornamento
    // di riscatto (usedCount +1 e uid in usedBy) è concesso anche all'utente che
    // riscatta, entro il limite maxUses e una sola volta per utente.
    match /vouchers/{code} {
      allow read: if request.auth != null;

      allow create: if isSuperAdminEmail()
        && code == request.resource.data.code
        && request.resource.data.credits is int
        && request.resource.data.credits > 0
        && request.resource.data.maxUses is int
        && request.resource.data.maxUses > 0
        && request.resource.data.usedCount == 0
        && request.resource.data.usedBy == []
        && request.resource.data.keys().hasAll([
          'code', 'credits', 'maxUses', 'usedCount', 'usedBy', 'createdAt'
        ]);

      allow update: if request.auth != null
        && (
          // Riscatto da parte di un utente.
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'usedBy'])
            && resource.data.usedCount < resource.data.maxUses
            && !(request.auth.uid in resource.data.usedBy)
            && request.resource.data.usedCount == resource.data.usedCount + 1
            && request.resource.data.usedBy.size() == resource.data.usedBy.size() + 1
            && request.auth.uid in request.resource.data.usedBy
          )
          // Il super-admin può correggere qualsiasi campo.
          || isSuperAdminEmail()
        );

      allow delete: if isSuperAdminEmail();
    }
  }
}
